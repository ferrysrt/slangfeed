; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SlangFeed"
config/description="Educational Internet Slang Game"
run/main_scene="res://scenes/splash_screen.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

Config="*res://scripts/autoload/config.gd"
GameData="*res://scripts/autoload/game_data.gd"
SessionManager="*res://scripts/autoload/session_manager.gd"
DatasetLoader="*res://scripts/autoload/dataset_loader.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=854
window/size/resizable=false
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[gui]

theme/custom="res://assets/themes/instagram_dark.tres"

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194310,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="mobile"
